  m_Name: ExchangeCamp_DE
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  sequenceLabelId: ExchangeCamp_DE
  narrativeCategory: 1
  dialogueLines:
  - subtitleText: "Dieser Bereich war das 1943 eingerichtete Austauschlager. J\xFCdische
      Geiseln wurden hier festgehalten, um gegen internierte Deutsche oder Devisen
      ausgetauscht zu werden. Aber f\xFCr \xFCber zweitausend von ihnen bedeutete
      es nur eine kurze Verschonung vor ihrer Ermordung in Auschwitz."
