  sequenceLabelId: A4
  narrativeCategory: 2
  dialogueLines:
  - subtitleText: "Elka Weissfeld,\nDaughter of 'Mr.' Jizchak Zwi,\ndeceased in the
      year 705.\nIn memory of our dearly beloved,\nhonored sister\nKl\xE1rika.\nWe
      erected this plaque,\nher brothers and sisters.\nKlara Weissfeld,\n'born in'
      Sziksz\xF3.\n1922 - 1945\nWe will never forget."
