MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1976516865}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ece71aa7c9e82c40b12e4aac9d434f9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CoachmarkTutorialController
  steps:
  - highlightTargets: []
    textEN: Tap here to open the main menu.
    textDE: "Tippe hier, um das Hauptmen\xFC zu \xF6ffnen."
    textHE: 
    transitions: []
    isToast: 0
    toastDuration: 4
    allowManualAdvance: 0
  - highlightTargets: []
    textEN: From here you can search for a person by name, or explore the map. Try
      one of the two.
    textDE: Von hier aus kannst du eine Person namentlich suchen oder die Karte erkunden.
      Probier eines von beidem aus.
    textHE: 
    transitions: []
    isToast: 0
    toastDuration: 4
    allowManualAdvance: 0
  - highlightTargets: []
    textEN: "Type a name, for example \u201CFrank\u201D."
    textDE: "Gib einen Namen ein, zum Beispiel \u201EFrank\u201C."
    textHE: 
    transitions: []
    isToast: 0
    toastDuration: 4
    allowManualAdvance: 1
  - highlightTargets: []
    textEN: "Tap the name to read their story, or tap \u2795 to add them to your
      route right away."
    textDE: "Tippe auf den Namen, um die Geschichte zu lesen, o der tippe auf \u2795,
      um die Person direttamente zu deiner Route hinzuzuf\xFCgen."
    textHE: 
    transitions: []
    isToast: 0
    toastDuration: 4
    allowManualAdvance: 0
  - highlightTargets: []
    textEN: Tap a point on the map to see who it belongs to.
    textDE: "Tippe auf einen Punkt auf der Karte, um zu sehen, wem er geh\xF6rt."
    textHE: 
    transitions: []
    isToast: 0
    toastDuration: 4
    allowManualAdvance: 0
  - highlightTargets: []
    textEN: "Listen to their story, or tap \u201CGo here\u201D to start your route
      to this stone."
    textDE: "H\xF6re dir die Geschichte an oder tippe auf \u201EHierher gehen\u201C,
      um die Route zu diesem Stein zu starten."
    textHE: 
    transitions: []
    isToast: 0
    toastDuration: 4
    allowManualAdvance: 0
  - highlightTargets: []
    textEN: "Tutorial complete \u2014 you can turn it back on anytime from the \u2630
      menu."
    textDE: "Tutorial abgeschlossen \u2013 du kannst es jederzeit \xFCber das \u2630-Men\xFC
      wieder aktivieren."
    textHE: 
    transitions: []
    isToast: 1
    toastDuration: 4
    allowManualAdvance: 0
  jumpToStepIndexIfRouteNonEmpty: -1
  overlayRoot: {fileID: 1639196392}
  frameTop: {fileID: 210981860}
  frameBottom: {fileID: 664248894}
